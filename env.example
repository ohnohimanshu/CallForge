# CallForge Configuration — Tuned for ultra-low latency (<800ms) on CPU
LOG_LEVEL=INFO

TELEPHONY_HOST=0.0.0.0
TELEPHONY_PORT=9092
# Per-agent simultaneous calls
TELEPHONY_MAX_CONCURRENT_CALLS=4
STT_THREAD_POOL_WORKERS=2

# Ultra-low latency VAD: noise-resilient threshold & 380ms silence cut-off
VAD_SPEECH_THRESHOLD=0.55
VAD_MIN_SILENCE_MS=380
VAD_PRE_SPEECH_PADDING_MS=220
VAD_MIN_SPEECH_MS=260

# Fast STT on CPU: 'base' provides 3-4x faster transcription than 'small' (~120ms vs ~500ms)
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_BEAM_SIZE=1
STT_MODEL_SIZE=base
STT_INITIAL_PROMPT="Hello, I want to book an appointment. Available slots are 10:00 AM, 02:30 PM, 04:00 PM."

# Ollama LLM: 4 physical CPU cores, max 45 tokens per conversational turn (sub-second on CPU)
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=llama3.2:3b-instruct-q4_K_M
LLM_NUM_THREAD=4
LLM_NUM_PREDICT=45
LLM_TEMPERATURE=0.4

# Fast TTS streaming
TTS_VOICE_MODEL_PATH=models/piper/en_US-ryan-medium.onnx
TTS_VOICE_CONFIG_PATH=models/piper/en_US-ryan-medium.onnx.json
TTS_VOICE_MODEL_PATH_HI=models/piper/hi_IN-priyamvada-medium.onnx
TTS_VOICE_CONFIG_PATH_HI=models/piper/hi_IN-priyamvada-medium.onnx.json
TTS_LENGTH_SCALE=1.0
TTS_NOISE_SCALE=0.667
TTS_NOISE_W_SCALE=0.8
TTS_VOLUME=1.05
TTS_SENTENCE_MIN_CHARS=4

LLM_GREETING_TEXT="Thank you for calling. How may I help you today?"
LLM_INITIAL_SILENCE_TIMEOUT_S=2.0

# HTTPS (SSL) configuration — uses local dev certs in certs/
SSL_KEYFILE=certs/key.pem
SSL_CERTFILE=certs/cert.pem
