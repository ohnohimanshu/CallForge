# Copy to `.env` and adjust for your environment. Defaults below are tuned
# for an 8GB RAM / CPU-only laptop (no GPU) running Asterisk natively on
# the same machine as this stack.

# LOG_LEVEL=INFO

# TELEPHONY_HOST=0.0.0.0
# TELEPHONY_PORT=9092
# TELEPHONY_MAX_CONCURRENT_CALLS=2

# API_HOST=0.0.0.0
# API_PORT=8080

# VAD_SPEECH_THRESHOLD=0.5
# VAD_MIN_SILENCE_MS=700
# VAD_PRE_SPEECH_PADDING_MS=300
# VAD_MAX_UTTERANCE_MS=20000

# STT_MODEL_SIZE=small
# STT_DEVICE=cpu
# STT_COMPUTE_TYPE=int8
# STT_BEAM_SIZE=3

# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=llama3.2:3b-instruct-q4_K_M
# LLM_TEMPERATURE=0.45
# LLM_NUM_PREDICT=96

# TTS_VOICE_MODEL_PATH=models/piper/en_US-lessac-medium.onnx
# TTS_VOICE_MODEL_PATH_HI=models/piper/hi_IN-priyamvada-medium.onnx
# TTS_LENGTH_SCALE=1.12
# TTS_NOISE_SCALE=0.5
# TTS_NOISE_W_SCALE=0.7
# TTS_VOLUME=1.05

# LLM_GREETING_TEXT="Thank you for calling. How may I help you today?"
# LLM_INITIAL_SILENCE_TIMEOUT_S=2.5

# --- Dedicated Customer Phone Numbers (DIDs) ---
# Primary & cheapest carrier (recommended: ~$1.00/mo, ~$0.0035/min inbound):
# TELNYX_API_KEY=KEY...
# TELNYX_SIP_CONNECTION_ID=...

# Alternative carrier (Twilio):
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_SIP_TRUNK_SID=TK...

# Platform retail pricing charged to users:
# PHONE_NUMBER_MONTHLY_PRICE=4.99
# PHONE_NUMBER_PER_MINUTE_PRICE=0.09
# PHONE_NUMBER_CURRENCY=USD

