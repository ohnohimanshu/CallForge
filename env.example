# ==============================================================================
# CallForge Environment Configuration
# Copy to `.env` to override defaults.
# Primary integration: FreePBX Method 1 (Direct AudioSocket) — no SIP trunk needed.
# ==============================================================================

# Application logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# AudioSocket telephony settings (FreePBX connects here)
TELEPHONY_HOST=0.0.0.0
TELEPHONY_PORT=9092
TELEPHONY_MAX_CONCURRENT_CALLS=4

# REST API & Web UI settings
API_HOST=0.0.0.0
API_PORT=8080

# ---------------------------------------------------------------------------
# FreePBX Method 1 (Direct AudioSocket) — RECOMMENDED
# ---------------------------------------------------------------------------
# LAN IP / hostname that FreePBX uses to reach THIS CallForge host.
# Example: FREEPBX_AUDIOSOCKET_HOST=10.17.2.139
FREEPBX_AUDIOSOCKET_HOST=
# Public HTTP base FreePBX CURL uses for caller-id + handoff (default http://<host>:8080)
FREEPBX_API_BASE=
CALLFORGE_PUBLIC_URL=
# Docker-internal hostname used when FreePBX is NOT the PBX (legacy compose network)
AUDIOSOCKET_HOST=voice-agent

# Voice Activity Detection (Silero VAD)
VAD_SPEECH_THRESHOLD=0.55
VAD_MIN_SILENCE_MS=380
VAD_PRE_SPEECH_PADDING_MS=220
VAD_MIN_SPEECH_MS=260
VAD_MAX_UTTERANCE_MS=20000

# Speech-to-Text (faster-whisper)
STT_MODEL_SIZE=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_BEAM_SIZE=1

# Local LLM (Ollama)
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=llama3.2:3b-instruct-q4_K_M
LLM_NUM_PREDICT=110
LLM_TEMPERATURE=0.4

# Text-to-Speech (Piper ONNX)
TTS_VOICE_MODEL_PATH=/models/piper/en_US-amy-medium.onnx
TTS_VOICE_MODEL_PATH_HI=/models/piper/hi_IN-priyamvada-medium.onnx
TTS_LENGTH_SCALE=1.0
TTS_NOISE_SCALE=0.667
TTS_NOISE_W_SCALE=0.8
TTS_VOLUME=1.05

# Greetings and Silence Timers
LLM_GREETING_TEXT="Thank you for calling. How may I help you today?"
LLM_INITIAL_SILENCE_TIMEOUT_S=2.0

# ---------------------------------------------------------------------------
# FreePBX Telephony Server Container Settings
# ---------------------------------------------------------------------------
# Local port mapped for FreePBX Web GUI (bound only to 127.0.0.1 for security)
FREEPBX_WEB_PORT=8088
FREEPBX_GUI_URL=http://127.0.0.1:8088/admin
FREEPBX_DB_ROOT_PASS=callforge_db_root_pass
FREEPBX_DB_PASS=callforge_asterisk_pass

# --- Optional External Carrier Phone Numbers (DIDs) ---
# TELNYX_API_KEY=
# TELNYX_SIP_CONNECTION_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SIP_TRUNK_SID=
